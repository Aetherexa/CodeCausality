{
  "name": "codecausality-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first change impact intelligence for software repositories.",
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm build:packages && pnpm --filter codecausality build",
    "build:packages": "tsc -b packages/core packages/cli packages/mcp",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm --filter @codecausality/core test && pnpm --filter @codecausality/mcp test",
    "test:coverage": "pnpm --filter @codecausality/core test:coverage",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm --filter @codecausality/mcp test && pnpm build",
    "quality": "pnpm check",
    "package:vsix": "pnpm --filter codecausality package:vsix",
    "package:vscode": "pnpm package:vsix"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
