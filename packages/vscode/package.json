{
  "name": "codecausality",
  "displayName": "CodeCausality — Change Impact Intelligence",
  "description": "Understand your repository and see what a code change can affect before you ship it.",
  "version": "1.0.0",
  "publisher": "aetherexa",
  "license": "SEE LICENSE IN LICENSE",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aetherexa/CodeCausality.git"
  },
  "homepage": "https://github.com/Aetherexa/CodeCausality/tree/main/packages/vscode",
  "bugs": {
    "url": "https://github.com/Aetherexa/CodeCausality/issues"
  },
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "keywords": [
    "change impact",
    "blast radius",
    "dependency graph",
    "repository intelligence",
    "architecture",
    "code review",
    "affected tests",
    "git",
    "static analysis",
    "codebase understanding"
  ],
  "files": [
    "dist/extension.js",
    "README.md",
    "CHANGELOG.md",
    "SUPPORT.md",
    "PRIVACY.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Testing",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "CodeCausality reads workspace source files and local Git history to build repository change-impact intelligence."
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:codecausality.impactExplorer",
    "onCommand:codecausality.analyzeCurrentFile",
    "onCommand:codecausality.analyzeWorkingTree",
    "onCommand:codecausality.openGettingStarted"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codecausality.analyzeCurrentFile",
        "title": "CodeCausality: Analyze Current File"
      },
      {
        "command": "codecausality.analyzeWorkingTree",
        "title": "CodeCausality: Analyze Working Tree"
      },
      {
        "command": "codecausality.openGettingStarted",
        "title": "CodeCausality: Getting Started"
      }
    ],
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "codecausality.impactExplorer",
          "name": "CodeCausality Impact"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codecausality.analyzeCurrentFile",
          "when": "view == codecausality.impactExplorer",
          "group": "navigation@1"
        },
        {
          "command": "codecausality.analyzeWorkingTree",
          "when": "view == codecausality.impactExplorer",
          "group": "navigation@2"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "codecausality.gettingStarted",
        "title": "Understand Change Before You Ship",
        "description": "Use CodeCausality to inspect repository relationships and understand the likely impact of a code change.",
        "steps": [
          {
            "id": "open-repository",
            "title": "Open a repository",
            "description": "Open a JavaScript or TypeScript Git repository. CodeCausality analyzes source relationships locally inside your workspace."
          },
          {
            "id": "current-file",
            "title": "Inspect one file",
            "description": "Open a source file, then run [CodeCausality: Analyze Current File](command:codecausality.analyzeCurrentFile) to see downstream impact."
          },
          {
            "id": "working-tree",
            "title": "Inspect your current changes",
            "description": "Run [CodeCausality: Analyze Working Tree](command:codecausality.analyzeWorkingTree) to see the combined blast radius of your Git changes."
          },
          {
            "id": "review-evidence",
            "title": "Follow the evidence",
            "description": "Use the impact graph, affected files, recommended tests, architecture guardrails, ownership, and history signals to understand the change before you ship it."
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vscode:prepublish": "npm run build",
    "package:vsix": "npx --yes @vscode/vsce@4.0.0 package --no-dependencies",
    "package:vsix:pnpm": "pnpm run build && pnpm dlx @vscode/vsce@4.0.0 package --no-dependencies"
  },
  "devDependencies": {
    "@codecausality/core": "0.1.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
